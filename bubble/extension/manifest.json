{
  "manifest_version": 3,
  "name": "Blopus Intent",
  "version": "1.0",
  "description": "Sends compose intent signals to Blopus bubble overlay.",
  "permissions": ["activeTab"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
